NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit origin used in authentication redirects.
STUDIO_SITE_URL=http://localhost:3000
# Server-only, generate with openssl rand -hex 32.
STUDIO_AUTH_SECRET=
# Server-only Supabase secret key or legacy service_role key. Enables account deletion.
SUPABASE_SECRET_KEY=
# Optional, development-only synthetic data.
STUDIO_DEMO=0

# Stripe test mode only. A Checkout session requires a test secret key and a signed webhook.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Build-time prefix. Use /studio for a subpath deployment and empty for root installs.
NEXT_PUBLIC_STUDIO_BASE_PATH=
